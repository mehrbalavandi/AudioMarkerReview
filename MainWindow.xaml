<Window x:Class="AudioMarkerReview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Audio Marker Review" Height="720" Width="1150" MinHeight="500" MinWidth="700">
    <Window.Resources>
        <Style x:Key="MarkerThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#CCFF6B00" BorderBrush="#FFCC5500" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MarkerThumbSelectedStyle" TargetType="Thumb">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Cursor" Value="SizeWE"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#CC2196F3" BorderBrush="#FF0D47A1" BorderThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="OpenAudioButton" Content="Open Audio..." Click="OpenAudioButton_Click" Padding="8,2"/>
                <Button x:Name="OpenDocxButton" Content="Open Word Document..." Click="OpenDocxButton_Click" Padding="8,2"/>
                <Button x:Name="OpenTextButton" Content="Open Text (.txt)..." Click="OpenTextButton_Click" Padding="8,2"/>
                <Button x:Name="LoadDraftButton" Content="Load Draft JSON..." Click="LoadDraftButton_Click" Padding="8,2"/>
                <TextBlock Text="Track:" VerticalAlignment="Center" Margin="8,0,2,0"/>
                <ComboBox x:Name="TrackComboBox" Width="220" DisplayMemberPath="AudioTrackName"
                          SelectionChanged="TrackComboBox_SelectionChanged" IsEnabled="False"/>
            </ToolBar>
            <ToolBar>
                <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPauseButton_Click" Width="60" IsEnabled="False"/>
                <TextBlock Text="Speed:" VerticalAlignment="Center" Margin="8,0,2,0"/>
                <ComboBox x:Name="SpeedComboBox" Width="70" SelectionChanged="SpeedComboBox_SelectionChanged" SelectedIndex="2">
                    <ComboBoxItem Content="0.5x"/>
                    <ComboBoxItem Content="0.75x"/>
                    <ComboBoxItem Content="1.0x"/>
                    <ComboBoxItem Content="1.25x"/>
                    <ComboBoxItem Content="1.5x"/>
                    <ComboBoxItem Content="2.0x"/>
                </ComboBox>
                <Separator/>
                <Button x:Name="UndoButton" Content="Undo" Click="UndoButton_Click" Padding="8,2" IsEnabled="False" ToolTip="Ctrl+Z"/>
                <Button x:Name="RedoButton" Content="Redo" Click="RedoButton_Click" Padding="8,2" IsEnabled="False" ToolTip="Ctrl+Y"/>
                <Separator/>
                <Button x:Name="ZoomOutButton" Content="Zoom −" Click="ZoomOutButton_Click" Padding="8,2"/>
                <Button x:Name="ZoomInButton" Content="Zoom +" Click="ZoomInButton_Click" Padding="8,2"/>
                <Separator/>
                <Button x:Name="CopyMarkersButton" Content="Copy Marker Text" Click="CopyMarkersButton_Click" Padding="8,2" IsEnabled="False"/>
                <Button x:Name="SaveMarkersButton" Content="Save As .txt..." Click="SaveMarkersButton_Click" Padding="8,2" IsEnabled="False"/>
                <Button x:Name="ExportDocxButton" Content="Export to Word (.docx)..." Click="ExportDocxButton_Click" Padding="8,2" IsEnabled="False"/>
            </ToolBar>
            <ToolBar>
                <TextBlock Text="Selected markers:" VerticalAlignment="Center" Margin="4,0,2,0"/>
                <TextBlock x:Name="SelectionInfoText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0" MinWidth="14"/>
                <Button x:Name="NudgeMinus50Button" Content="◀ 50ms" Click="NudgeMinus50Button_Click" Padding="6,2" IsEnabled="False"/>
                <Button x:Name="NudgeMinus10Button" Content="◀ 10ms" Click="NudgeMinus10Button_Click" Padding="6,2" IsEnabled="False"/>
                <Button x:Name="NudgePlus10Button" Content="10ms ▶" Click="NudgePlus10Button_Click" Padding="6,2" IsEnabled="False"/>
                <Button x:Name="NudgePlus50Button" Content="50ms ▶" Click="NudgePlus50Button_Click" Padding="6,2" IsEnabled="False"/>
                <Separator/>
                <Button x:Name="ClearSelectionButton" Content="Clear Selection" Click="ClearSelectionButton_Click" Padding="6,2" IsEnabled="False"/>
            </ToolBar>
        </ToolBarTray>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Margin="8,4,8,0" Text="No files loaded yet." Foreground="#555" TextWrapping="Wrap"/>
        <TextBlock DockPanel.Dock="Top" Margin="8,0,8,4" FontStyle="Italic" Foreground="#888" TextWrapping="Wrap"
                   Text="Tip: Ctrl+Click a marker to multi-select, Shift+Click to select a range, then drag any selected marker (or use the ms buttons above) to move the whole group together."/>

        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0" Height="230">
            <ScrollViewer x:Name="WordsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6">
                <ItemsControl x:Name="WordsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ScrollViewer x:Name="WaveScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid x:Name="WaveHostGrid" Height="180" Width="800" Background="#1E1E1E"
                  MouseLeftButtonDown="WaveHostGrid_MouseLeftButtonDown">
                <Path x:Name="WaveformPath" Fill="#4FA8E0" Stretch="None"
                      HorizontalAlignment="Left" VerticalAlignment="Top"/>
                <Canvas x:Name="MarkerCanvas" Background="Transparent"/>
                <Line x:Name="PlayheadLine" Stroke="Red" StrokeThickness="2"
                      Y1="0" Y2="180" X1="0" X2="0" IsHitTestVisible="False"/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
